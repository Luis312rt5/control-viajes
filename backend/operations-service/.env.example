PORT=3002
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=operations_db
# URL HTTP (incluyendo /internal) de trips-service. En docker-compose es
# http://trips-service:3001/internal; en Render, la URL pública del servicio.
TRIPS_SERVICE_URL=http://trips-service:3001/internal
# Debe ser igual al INTERNAL_API_KEY del gateway y de trips-service.
INTERNAL_API_KEY=dev_internal_key_change_me
