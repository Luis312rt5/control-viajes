PORT=3000
JWT_SECRET=super_secret_key_change_in_production
# URLs HTTP (incluyendo /internal) de los microservicios. En docker-compose
# son las de abajo; en Render, las URLs públicas de cada servicio desplegado.
TRIPS_SERVICE_URL=http://trips-service:3001/internal
OPERATIONS_SERVICE_URL=http://operations-service:3002/internal
# Debe ser igual al INTERNAL_API_KEY de trips-service y operations-service.
INTERNAL_API_KEY=dev_internal_key_change_me
