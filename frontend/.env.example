# En desarrollo local, deja el valor de abajo (o bórralo: api/client.ts ya
# usa '/api' por defecto y Vite lo redirige al backend local, ver
# vite.config.ts).
#
# En Vercel, configura esta variable en Project Settings -> Environment
# Variables con la URL pública del gateway desplegado en Render, terminada
# en /api (ej: https://gateway-xxxx.onrender.com/api).
VITE_API_URL=http://localhost:3000/api
